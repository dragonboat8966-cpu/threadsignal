# Meta Threads API（需 threads_keyword_search 權限）
THREADS_ACCESS_TOKEN=

# OpenAI API；留空時會使用內建規則生成文案
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 伺服器
PORT=8787
COLLECT_AT=08:30
TIMEZONE=Asia/Taipei

# Public Threads OAuth review demo
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-domain.example/auth/threads/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
