# Meta Threads API（需 threads_keyword_search 權限）
THREADS_ACCESS_TOKEN=

# OpenAI API（AI 語意篩選必要）；需使用有效金鑰，且所屬專案須有可用 API 額度
# 關鍵字只負責找候選內容；AI 判定未通過、失敗或額度不足時，候選內容不會顯示
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# AI 篩選來源：openai（網站即時 API）或 local_codex（本機 Codex 排程）
AI_FILTER_PROVIDER=local_codex
# local_codex 模式必要：網站與本機共用的獨立隨機密鑰，至少 32 個字元
LOCAL_ANALYZER_SECRET=
THREADSIGNAL_SITE_URL=https://threadsignal-m2w6.vercel.app

# 伺服器
PORT=8787
COLLECT_AT=08:30
TIMEZONE=Asia/Taipei

# Public Threads OAuth review demo
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-domain.example/auth/threads/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
# 正式環境建議填寫不可變的 Threads User ID。若尚不知道 ID，可先用下方 username
# 完成第一次連線；系統綁定第一位 owner 後即以資料庫中的 User ID 為準。
OWNER_THREADS_USER_ID=
OWNER_THREADS_USERNAME=your_threads_username
DATABASE_URL=
CRON_SECRET=replace-with-a-random-secret
