{
  "name": "threadsignal",
  "version": "1.0.0",
  "private": true,
  "description": "Threads 關鍵字商機蒐集、需求分類與 AI 文案工作台",
  "scripts": {
    "local": "node server.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "node --check server.js && node --check public/app.js",
    "local-ai:setup-secret": "node scripts/setup-local-ai-secret.mjs",
    "local-ai:download": "node --env-file=.env.local scripts/local-ai-download.mjs",
    "local-ai:upload": "node --env-file=.env.local scripts/local-ai-upload.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "^15.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
